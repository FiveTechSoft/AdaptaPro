{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fivetechsoft.github.io/packs/schemas/locale.schema.json",
  "title": "Sobrecarga de localizacion de un pack",
  "description": "Todo archivo bajo XX/locale/ usa este envoltorio. Declara moneda, formatos y jurisdiccion; no contiene textos de interfaz del nucleo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "country", "locale", "currency", "formats", "jurisdiction", "notes"],
  "properties": {
    "schema_version": { "const": 1 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui", "number", "money"],
      "properties": {
        "ui": { "type": "string" },
        "number": { "type": "string" },
        "money": { "type": "string" }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "tax_label", "core_status"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "tax_label": { "type": "string", "minLength": 1 },
        "core_status": { "type": "string", "minLength": 1 }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
