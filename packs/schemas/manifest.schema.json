{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fivetechsoft.github.io/packs/schemas/manifest.schema.json",
  "title": "Manifiesto de pack por pais",
  "description": "Contrato declarativo. Un pack no activa funciones: solo documenta alcance, estado y fuentes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "country",
    "name",
    "status",
    "runtime_enabled",
    "maintainer",
    "scope",
    "sources",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["borrador", "en_revision", "validado"] },
    "runtime_enabled": { "const": false },
    "maintainer": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "checked_on", "effective_on", "review_status"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "checked_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "effective_on": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "review_status": { "enum": ["pendiente", "revisada"] }
        }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
